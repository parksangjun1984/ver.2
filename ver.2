],

'deco_보호랩 불량':[
  {q:'동일 LOT에서 동일 증상이 발생했나요?',
   hint:'점착제 전이·강도 문제 확인',
   warranty:'1년',
   answers:[
     {label:'예 — 동일 LOT 불량',
      type:'product', as:'의무',
      action:'제품성 귀책입니다.\n→ LOT 기록 후 교체 진행',
      checks:['불량 위치 사진 촬영','동일 LOT 전수 확인','LOT 번호 기록','교체 발주']},
     {label:'아니오',
