<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>하자판정 도우미 | 현대엘앤씨</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Apple SD Gothic Neo','Malgun Gothic',sans-serif;background:#fff;color:#111827;min-height:100vh;padding-bottom:60px;}
.header{background:#1A1A1A;padding:9px 16px;position:sticky;top:0;z-index:999;box-shadow:0 2px 8px rgba(0,0,0,.3);}
.header-inner{max-width:600px;margin:0 auto;display:flex;align-items:center;}
.logo-box{display:flex;align-items:center;gap:0;}
.logo-hyun{background:#2BA99B;padding:4px 7px;display:flex;align-items:center;}
.logo-hyun-txt{font-size:11px;font-weight:900;color:#fff;letter-spacing:2px;font-family:'Arial Black','Arial',sans-serif;}
.logo-d{background:#1A1A1A;padding:4px 5px;display:flex;align-items:center;border-left:1px solid #444;border-right:1px solid #444;}
.logo-d-txt{font-size:11px;font-weight:900;color:#fff;letter-spacing:0;font-family:'Arial Black','Arial',sans-serif;}
.logo-ai{background:#E8A020;padding:4px 7px;display:flex;align-items:center;}
.logo-ai-txt{font-size:11px;font-weight:900;color:#fff;letter-spacing:2px;font-family:'Arial Black','Arial',sans-serif;}
.logo-lc{margin-left:7px;font-size:11px;font-weight:700;color:#2BA99B;letter-spacing:1.5px;}
.header-sub{margin-left:auto;font-size:11px;color:rgba(255,255,255,.55);}
.wrap{max-width:600px;margin:0 auto;padding:18px 16px 0;}
.screen{display:none;}.screen.on{display:block;}
.hero{background:#2BA99B;border-radius:14px;padding:24px 20px;color:#fff;margin-bottom:14px;}
.hero-tag{font-size:10px;opacity:.7;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px;}
.hero-title{font-size:20px;font-weight:800;line-height:1.35;margin-bottom:8px;}
.hero-desc{font-size:13px;opacity:.8;line-height:1.65;}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.chip{padding:5px 11px;background:#e1f5f0;border:1px solid #a3d9cc;border-radius:100px;font-size:12px;color:#085041;font-weight:500;}
.card{background:#fff;border-radius:14px;padding:20px 18px;box-shadow:0 2px 12px rgba(0,0,0,.07);margin-bottom:14px;border:1px solid #d5ede8;}
.card-lbl{font-size:10px;font-weight:700;letter-spacing:1.2px;color:#2BA99B;text-transform:uppercase;margin-bottom:8px;}
.card-q{font-size:17px;font-weight:800;line-height:1.4;margin-bottom:16px;}
.stepbar{display:flex;align-items:center;gap:5px;margin-bottom:14px;}
.dot{height:7px;border-radius:4px;transition:all .25s;background:#e0e0e0;}
.dot.act{width:20px;background:#2BA99B;}
.dot.idle{width:7px;border-radius:50%;}
.dot.done{width:7px;border-radius:50%;background:#2BA99B;opacity:.35;}
.step-lbl{margin-left:auto;font-size:11px;color:#6b7280;font-family:monospace;}
.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px;}
.pcard{padding:16px 10px;border:1.5px solid #e5e9f4;border-radius:12px;background:#fff;text-align:center;cursor:pointer;}
.pcard:active{background:#f0faf5;border-color:#2BA99B;}
.p-emoji{font-size:26px;margin-bottom:6px;}
.p-name{font-size:14px;font-weight:700;}
.p-sub{font-size:11px;color:#6b7280;margin-top:2px;}
.opt{display:flex;align-items:center;gap:12px;padding:14px;border:1.5px solid #e5e9f4;border-radius:12px;background:#fff;margin-bottom:8px;cursor:pointer;}
.opt:active{background:#f0faf5;border-color:#2BA99B;}
.opt-icon{font-size:20px;width:28px;text-align:center;flex-shrink:0;}
.opt-text{font-size:15px;font-weight:600;line-height:1.4;}
.opt-sub{font-size:12px;color:#6b7280;margin-top:2px;}
/* 체크리스트 */
.ck-sec{margin-bottom:18px;}
.ck-title{font-size:14px;font-weight:700;color:#111827;margin-bottom:6px;padding:10px 14px;background:#f0faf5;border-radius:10px;border-left:3px solid #2BA99B;line-height:1.5;}
.ck-title.unanswered{background:#fff5f5;border-left-color:#ef4444;}
.ck-hint{font-size:11px;color:#6b7280;margin-top:4px;font-weight:400;}
.ck-warrant{display:inline-block;padding:2px 8px;border-radius:100px;font-size:11px;font-weight:600;background:#fff8e1;color:#b45309;margin-left:6px;vertical-align:middle;}
.yn-row{display:flex;gap:8px;margin-top:8px;}
.yn-btn{flex:1;padding:11px 8px;border-radius:10px;border:1.5px solid #e5e9f4;font-size:13px;font-weight:700;cursor:pointer;text-align:center;background:#fff;line-height:1.3;}
.yn-btn.sel-y{background:#2BA99B;border-color:#2BA99B;color:#fff;}
.yn-btn.sel-n{background:#ef4444;border-color:#ef4444;color:#fff;}
/* 결과 */
.result-box{border-radius:14px;padding:20px 18px;margin-bottom:14px;border:1.5px solid;}
.type-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:100px;font-size:13px;font-weight:700;color:#fff;margin-bottom:10px;}
.verdict-chip{display:block;padding:12px 16px;border-radius:10px;font-size:15px;font-weight:700;margin-bottom:14px;text-align:center;}
.warranty-box{padding:10px 14px;border-radius:10px;background:#fff8e1;border:1px solid #fde68a;margin-bottom:14px;font-size:13px;color:#92400e;}
.r-title{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;opacity:.55;}
.r-action{background:rgba(0,0,0,.05);border-radius:10px;padding:14px 15px;font-size:14px;line-height:1.7;margin-bottom:14px;}
.chk-list{display:flex;flex-direction:column;gap:7px;margin-bottom:14px;}
.chk-item{display:flex;gap:9px;font-size:14px;line-height:1.5;align-items:flex-start;}
/* 복사 버튼 */
.copy-btn{width:100%;padding:13px;border-radius:12px;border:1.5px solid #2BA99B;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;background:#fff;color:#2BA99B;margin-top:8px;}
.copy-btn:active{background:#f0faf5;}
/* 기타 */
.btn-row{display:flex;gap:8px;margin-top:6px;}
.btn{flex:1;padding:14px;border-radius:12px;border:none;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;}
.btn:active{opacity:.85;}
.btn-pri{background:#2BA99B;color:#fff;}
.btn-sec{background:#e5e9f4;color:#111827;}
.btn-judge{width:100%;padding:15px;border-radius:12px;border:none;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;background:#2BA99B;color:#fff;margin-top:16px;}
.back{background:none;border:none;font-size:13px;color:#6b7280;cursor:pointer;margin-bottom:14px;padding:4px 0;font-family:inherit;display:block;}
.disc{font-size:11px;color:#9ca3af;text-align:center;padding:10px 8px;line-height:1.7;}
.leg{display:flex;gap:9px;font-size:14px;line-height:1.6;margin-bottom:8px;align-items:flex-start;}
.err-msg{color:#ef4444;font-size:13px;text-align:center;padding:8px 0;display:none;}
</style>
</head>
<body>
<div class="header">
  <div class="header-inner">
    <div class="logo-box">
      <div class="logo-hyun"><span class="logo-hyun-txt">HYUN</span></div>
      <div class="logo-d"><span class="logo-d-txt">D</span></div>
      <div class="logo-ai"><span class="logo-ai-txt">AI</span></div>
      <span class="logo-lc">L &amp; C</span>
    </div>
    <span class="header-sub">품질전략팀</span>
  </div>
</div>
<div class="wrap">

  <!-- s0 인트로 -->
  <div id="s0" class="screen on">
    <div class="hero">
      <div class="hero-tag">품질전략팀 · CS 현장 도구</div>
      <div class="hero-title">현장에서 바로<br>하자유형 판정하기</div>
      <div class="hero-desc">점검 항목 순서대로 체크 → AS 대상 여부 즉시 확인</div>
    </div>
    <div class="chips">
      <span class="chip">🪟 완성창</span><span class="chip">🪵 마루</span><span class="chip">📜 장판</span>
      <span class="chip">🟫 PVC타일</span><span class="chip">🚪 중문</span><span class="chip">🖼️ 벽지</span>
      <span class="chip">🪨 인테리어스톤</span><span class="chip">🎨 장식자재</span>
    </div>
    <div class="card">
      <div class="card-lbl">하자유형 기준</div>
      <div class="leg"><span style="color:#0ea5e9;flex-shrink:0;padding-top:3px">●</span><div><strong>제품성</strong> — 제조·품질 불량 → AS 의무</div></div>
      <div class="leg"><span style="color:#10b981;flex-shrink:0;padding-top:3px">●</span><div><strong>현장성</strong> — 환경·관리 불량 → AS 기각</div></div>
      <div class="leg"><span style="color:#f59e0b;flex-shrink:0;padding-top:3px">●</span><div><strong>시공성</strong> — 설치·시공 불량 → AS 기각</div></div>
      <div class="leg"><span style="color:#8b5cf6;flex-shrink:0;padding-top:3px">●</span><div><strong>가공성</strong> — 재단·가공 불량 → AS 의무(가공사)</div></div>
      <div class="leg"><span style="color:#ef4444;flex-shrink:0;padding-top:3px">●</span><div><strong>사용성/민원성</strong> — 사용·관리 불량 → AS 기각</div></div>
    </div>
    <div class="btn-row">
      <button class="btn btn-pri" onclick="go('s1')">▶ 판정 시작하기</button>
    </div>
  </div>

  <!-- s1 품목 선택 -->
  <div id="s1" class="screen">
    <button class="back" onclick="go('s0')">← 처음으로</button>
    <div class="stepbar"><div class="dot act"></div><div class="dot idle"></div><div class="dot idle"></div><span class="step-lbl">STEP 1 / 3</span></div>
    <div class="card">
      <div class="card-lbl">Step 1</div>
      <div class="card-q">어떤 제품에서<br>하자가 발생했나요?</div>
      <div class="pgrid" id="pgrid"></div>
    </div>
  </div>

  <!-- s2 증상 선택 -->
  <div id="s2" class="screen">
    <button class="back" onclick="go('s1')">← 품목 다시 선택</button>
    <div class="stepbar"><div class="dot done"></div><div class="dot act"></div><div class="dot idle"></div><span class="step-lbl">STEP 2 / 3</span></div>
    <div class="card">
      <div class="card-lbl" id="s2lbl">Step 2</div>
      <div class="card-q">어떤 증상이<br>발생했나요?</div>
      <div id="s2list"></div>
    </div>
  </div>

  <!-- s3 체크리스트 -->
  <div id="s3" class="screen">
    <button class="back" onclick="go('s2')">← 증상 다시 선택</button>
    <div class="stepbar"><div class="dot done"></div><div class="dot done"></div><div class="dot act"></div><span class="step-lbl">STEP 3 / 3</span></div>
    <div class="card">
      <div class="card-lbl">Step 3 · 현장 점검 체크</div>
      <div class="card-q" id="s3title">아래 항목을 순서대로 확인하세요</div>
      <div id="s3list"></div>
      <div class="err-msg" id="errmsg">⚠ 답변하지 않은 항목이 있습니다. 위로 스크롤해서 확인하세요.</div>
      <button class="btn-judge" onclick="judgeResult()">✓ 판정하기</button>
    </div>
  </div>

  <!-- s4 결과 -->
  <div id="s4" class="screen">
    <button class="back" onclick="go('s0')">← 처음부터 다시</button>
    <div class="stepbar"><div class="dot done"></div><div class="dot done"></div><div class="dot done"></div><span class="step-lbl">판정 완료</span></div>
    <div id="s4body"></div>
    <button class="copy-btn" onclick="copyResult()">📋 결과 텍스트 복사</button>
    <div class="btn-row" style="margin-top:10px">
      <button class="btn btn-sec" onclick="go('s1')">다른 품목 판정</button>
      <button class="btn btn-pri" onclick="go('s0')">처음으로</button>
    </div>
    <div class="disc">※ 본 판정 결과는 현장 참고용이며, 최종 판단은 품질전략팀 확인이 필요합니다.<br>복합성·원인 불명 시 → 유관부서 2차 현장 동행실사 후 결정</div>
  </div>
</div>

