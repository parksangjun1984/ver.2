// 장판·타일 공통 항목 복사
var copyKeys={
  'floor_viny_이색 / 이광':'floor_wood_이색 / 이광',
  'floor_viny_변색':'floor_wood_변색',
  'floor_viny_들뜸 / 웨이브':'floor_wood_들뜸 / 웨이브',
  'floor_viny_이음매 / 이음부':'floor_wood_이음매 / 이음부',
  'floor_viny_박리':'floor_wood_박리',
  'floor_viny_운송 중 파손':'floor_wood_운송 중 파손',
  'tile_이색 / 이광':'floor_wood_이색 / 이광',
  'tile_변색':'floor_wood_변색',
  'tile_인쇄 불량':'floor_viny_인쇄 불량',
  'tile_단차':'floor_viny_단차',
  'tile_들뜸 / 웨이브':'floor_wood_들뜸 / 웨이브',
  'tile_이음매 / 이음부':'floor_wood_이음매 / 이음부'
};
Object.keys(copyKeys).forEach(function(k){CHECKS[k]=CHECKS[copyKeys[k]];});

// ── 상태 ──
var curP=null, curS=null, curChecks=[], answers=[], resultData=null;

function go(id){
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('on');});
  document.getElementById(id).classList.add('on');
  window.scrollTo(0,0);
}

// 품목 그리드 생성
var g=document.getElementById('pgrid');
PRODUCTS.forEach(function(p){
  var d=document.createElement('div'); d.className='pcard';
  d.innerHTML='<div class="p-emoji">'+p.e+'</div><div class="p-name">'+p.n+'</div><div class="p-sub">'+p.s+'</div>';
  d.onclick=(function(pk){return function(){curP=pk;buildS2(pk);go('s2');};})(p.k);
  g.appendChild(d);
});

function buildS2(pk){
  var pr=PRODUCTS.filter(function(p){return p.k===pk;})[0];
  document.getElementById('s2lbl').textContent='Step 2 · '+pr.n;
  var el=document.getElementById('s2list'); el.innerHTML='';
  SYMPTOMS[pk].forEach(function(sym){
    var d=document.createElement('div'); d.className='opt';
    d.innerHTML='<span class="opt-icon">'+sym.ico+'</span><div><div class="opt-text">'+sym.txt+'</div><div class="opt-sub">'+sym.sub+'</div></div>';
    d.onclick=(function(s){return function(){curS=s;buildS3(pk,s);};})(sym.txt);
    el.appendChild(d);
  });
}

function buildS3(pk,sym){
  var key=pk+'_'+sym;
  var checks=CHECKS[key];
  curChecks=checks||[];
  answers=new Array(curChecks.length).fill(null);
  document.getElementById('s3title').textContent=sym+' — 점검 항목을 순서대로 확인하세요';
  document.getElementById('errmsg').style.display='none';
  var el=document.getElementById('s3list'); el.innerHTML='';
  if(!curChecks.length){
    el.innerHTML='<div style="padding:16px;color:#6b7280;font-size:14px;text-align:center;">해당 항목은 현장 확인 후 품질전략팀에 문의하세요.</div>';
    go('s3'); return;
  }
  curChecks.forEach(function(ck,i){
    var sec=document.createElement('div'); sec.className='ck-sec'; sec.id='q'+i;
    var w=ck.warranty?'<span class="ck-warrant">보증 '+ck.warranty+'</span>':'';
    var h=ck.hint?'<div class="ck-hint">📌 '+ck.hint+'</div>':'';
    sec.innerHTML='<div class="ck-title" id="qt'+i+'">Q'+(i+1)+'. '+ck.q+w+h+'</div>';
    var yn=document.createElement('div'); yn.className='yn-row';
    ck.answers.forEach(function(ans,j){
      var btn=document.createElement('div'); btn.className='yn-btn';
      btn.innerHTML=ans.label;
      btn.onclick=(function(ii,jj,b){return function(){
        answers[ii]=jj;
        b.parentNode.querySelectorAll('.yn-btn').forEach(function(bb){bb.classList.remove('sel-y','sel-n');});
        b.classList.add(jj===0?'sel-y':'sel-n');
        document.getElementById('qt'+ii).classList.remove('unanswered');
      };})(i,j,btn);
      yn.appendChild(btn);
    });
    sec.appendChild(yn); el.appendChild(sec);
  });
  go('s3');
}

function judgeResult(){
  // 모든 질문 순서대로 통과 — type이 null이면 다음 질문으로 진행, type이 있으면 결과
  var firstUnanswered=-1;
  var finalType=null, finalAs='', finalAction='', finalChecks=[], finalWarranty='', finalQ='';

  for(var i=0;i<curChecks.length;i++){
    if(answers[i]===null){
      if(firstUnanswered===-1) firstUnanswered=i;
      // 이전 답변으로 이미 결과가 나왔으면 OK
      continue;
    }
    var ans=curChecks[i].answers[answers[i]];
    if(ans.type){
      finalType=ans.type;
      finalAs=ans.as;
      finalAction=ans.action;
      finalChecks=ans.checks||[];
      finalWarranty=curChecks[i].warranty||'';
      finalQ='Q'+(i+1)+'. '+curChecks[i].q;
      break;
    }
    // type=null이면 다음 질문으로
  }

  // 미답변 항목 표시
  if(firstUnanswered!==-1 && !finalType){
    document.getElementById('errmsg').style.display='block';
    document.getElementById('qt'+firstUnanswered).classList.add('unanswered');
    document.getElementById('q'+firstUnanswered).scrollIntoView({behavior:'smooth'});
    return;
  }
  if(!finalType){
    finalType='field'; finalAs='보류';
    finalAction='복합 원인으로 판단 보류입니다.\n→ 유관부서 2차 현장 동행실사 후 결정';
    finalChecks=['판정 결과 품질전략팀 보고','유관부서 2차 현장 동행 일정 조율','현장 사진 자료 정리 후 공유'];
  }

  var m=TM[finalType];
  var pr=PRODUCTS.filter(function(p){return p.k===curP;})[0];
  resultData={product:pr.n, symptom:curS, type:m.lbl, as:finalAs, action:finalAction, checks:finalChecks, warranty:finalWarranty};

  var wBox=finalWarranty?'<div class="warranty-box">📋 보증기간 정보: '+finalWarranty+(finalAs==='의무'?' → 무상 처리 대상':finalAs==='기각'?' → AS 기각':' → 확인 필요')+'</div>':'';
  var chkHtml=finalChecks.map(function(c){return'<div class="chk-item"><span style="flex-shrink:0;color:#2BA99B">✓</span><span>'+c+'</span></div>';}).join('');
  var actionHtml=finalAction.replace(/\n/g,'<br>');

  document.getElementById('s4body').innerHTML=
    '<div class="result-box" style="background:'+m.bg+';border-color:'+m.color+'">'
    +'<div style="font-size:12px;color:#6b7280;margin-bottom:8px">'+pr.n+' · '+curS+'</div>'
    +'<div class="type-badge" style="background:'+m.color+'">'+m.ico+' '+m.lbl+'</div>'
    +'<div class="verdict-chip" style="background:'+m.vbg+';color:'+m.vco+'">'+m.verd+'</div>'
    +wBox
    +'<div class="r-title">⚡ 처리 방향</div>'
    +'<div class="r-action">'+actionHtml+'</div>'
    +'<div class="r-title">📋 현장 핵심 점검사항</div>'
    +'<div class="chk-list">'+chkHtml+'</div>'
    +'</div>';
  go('s4');
}

function copyResult(){
  if(!resultData) return;
  var txt='[현대L&C 하자판정 결과]\n';
  txt+='품목: '+resultData.product+'\n';
  txt+='증상: '+resultData.symptom+'\n';
  txt+='하자유형: '+resultData.type+'\n';
  txt+='AS 판정: '+resultData.as+'\n';
  if(resultData.warranty) txt+='보증기간: '+resultData.warranty+'\n';
  txt+='\n[처리 방향]\n'+resultData.action.replace(/<br>/g,'\n')+'\n';
  txt+='\n[현장 점검사항]\n'+resultData.checks.map(function(c,i){return(i+1)+'. '+c;}).join('\n');
  txt+='\n\n※ 본 결과는 현장 참고용이며 최종 판단은 품질전략팀 확인이 필요합니다.';
  if(navigator.clipboard){
    navigator.clipboard.writeText(txt).then(function(){alert('결과가 복사되었습니다.\n카카오톡·문자에 붙여넣기 하세요.');});
  } else {
    var ta=document.createElement('textarea'); ta.value=txt;
    document.body.appendChild(ta); ta.select(); document.execCommand('copy');
    document.body.removeChild(ta); alert('결과가 복사되었습니다.');
  }
}
</script>
